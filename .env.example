# 모찌네 청약 알리미 — 환경 변수 목록 (값은 비워 둡니다. 실제 값은 .env.local / Vercel / Supabase 시크릿에)
# 브라우저에 노출되는 값은 NEXT_PUBLIC_VAPID_PUBLIC_KEY 하나뿐이어야 합니다 (NFR-U1-16)

# --- U1: 서버(Next) 전용 ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 소득·자산 암호화 키 (AES-256, base64url 32바이트). 운영과 로컬은 서로 다른 값을 씁니다
AMOUNT_ENC_KEY_V1=
AMOUNT_ENC_KEY_CURRENT=1

# --- U3: Supabase Function 시크릿 (운영은 npx supabase secrets set) ---
# 공공데이터포털 Decoding 키 / Gemini 키 / 예약 작업 호출용 비밀 값(32바이트 base64url)
# DATA_GO_KR_API_KEY=
# (로컬) 실제 응답 캡처 node scripts/capture-fixtures.mjs 도 .env.local의 DATA_GO_KR_API_KEY를 읽음
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# CRON_SECRET=
# 로컬 전용: 1이면 실제 소스·Gemini 대신 목업 (운영에는 두지 않음)
# COLLECT_MOCK=1

# --- U6: 푸시 ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
