# 모찌네 청약 알리미 — 환경 변수 목록 (값은 비워 둡니다. 실제 값은 .env.local / Vercel / Supabase 시크릿에)
# 브라우저에 노출되는 값은 NEXT_PUBLIC_VAPID_PUBLIC_KEY 하나뿐이어야 합니다 (NFR-U1-16)

# --- U1: 서버(Next) 전용 ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 소득·자산 암호화 키 (AES-256, base64url 32바이트). 운영과 로컬은 서로 다른 값을 씁니다
AMOUNT_ENC_KEY_V1=
AMOUNT_ENC_KEY_CURRENT=1

# --- U3: Supabase Function 시크릿 ---
# DATA_GO_KR_API_KEY=
# GEMINI_API_KEY=

# --- U6: 푸시 ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
